@model CatFacts.Models.CatFact?

@{
    ViewData["Title"] = "Cat Facts";
}

<div class="text-center">
    <h1>Cat Facts 🐱</h1>

    <p>Get a random fact about cats.</p>

    <form asp-controller="Home" asp-action="GetFact" method="post">
        <button type="submit" class="btn btn-primary">
            Get Cat Fact
        </button>
    </form>

    @if (Model is not null)
    {
        <div class="mt-4">
            <h3>Random Cat Fact</h3>

            <p>
                @Model.Fact
            </p>

            <p>
                Length: @Model.Length
            </p>

            <p>
                Retrieved: @Model.CreatedAt
            </p>
        </div>
    }
</div>