<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CatFacts</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CatFacts.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="main-header">
        <div class="header-container">
            <a asp-controller="Home" asp-action="Index" class="brand-link">
                <span class="brand-icon">🐱</span>
                <span class="brand-text">Cat Facts</span>
            </a>
            <nav class="nav-links">
            <a asp-controller="Home" 
               asp-action="Index" 
               class="nav-item-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")">
                Home
            </a>
            <a asp-controller="Home" 
               asp-action="History" 
               class="nav-item-link @(ViewContext.RouteData.Values["action"]?.ToString() == "History" ? "active" : "")">
                History
            </a>
            <a asp-controller="Home" 
               asp-action="Stats" 
               class="nav-item-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Stats" ? "active" : "")">
                Statistics
            </a>
        </nav>
        </div>
    </header>
    <div class="page-container">
        <main role="main" >
            @RenderBody()
        </main>
    </div>

    
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
