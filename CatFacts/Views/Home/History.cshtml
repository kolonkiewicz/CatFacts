@model CatFacts.ViewModels.HistoryViewModel
@{
    ViewData["Title"] = "Fact History";
}

<div class="history-page">

    <div class="history-header">
        <h1>Fact History</h1>

        <p>
            Browse all previously fetched cat facts.
        </p>
    </div>

    <div class="history-filters">

        <form asp-controller="Home"
            asp-action="History"
            method="get"
            class="history-filter-form">

            <div class="filter-field">
                <label for="keyword">Keyword</label>

                <input
                    id="keyword"
                    type="text"
                    name="keyword"
                    value="@Model.Keyword"
                    placeholder="Search facts..." />
            </div>

            <div class="filter-field">
                <label for="from">From</label>

                <input
                    id="from"
                    type="date"
                    name="from"
                    value="@(Model.From?.ToString("yyyy-MM-dd"))" />
            </div>

            <div class="filter-field">
                <label for="to">To</label>

                <input
                    id="to"
                    type="date"
                    name="to"
                    value="@(Model.To?.ToString("yyyy-MM-dd"))" />
            </div>

            <button type="submit" class="search-button">
                Search
            </button>

        </form>

    </div>

    

    <div class="history-table-container">

        <div class="history-table-wrapper">

            <table class="history-table">

                <thead>
                    <tr>
                        <th>Date & Time</th>
                        <th>Length</th>
                        <th>Fact Content</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model.Facts.Count == 0)
                    {
                        <tr>
                            <td colspan="4" class="empty-history">
                                No facts have been fetched yet.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var fact in Model.Facts)
                        {
                            <tr>

                                <td class="mono history-date">
                                    @fact.CreatedAt.ToString("MMM d, yyyy HH:mm")
                                </td>

                                <td class="mono history-length">
                                    @fact.Length
                                </td>

                                <td class="history-content">
                                    @fact.Fact
                                </td>

                                <td>
                                    <button
                                        type="button"
                                        class="details-button"
                                        onclick="openDetails(@fact.Id)">
                                        Details
                                    </button>
                                </td>

                            </tr>
                        }
                    }

                </tbody>

            </table>

        </div>

    </div>
    
    @if (Model.TotalPages > 1)
    {
    <div class="history-pagination">

        @if (Model.CurrentPage > 1)
        {
            <a
                asp-controller="Home"
                asp-action="History"
                asp-route-page="@(Model.CurrentPage - 1)"
                asp-route-keyword="@Model.Keyword"
                asp-route-from="@Model.From?.ToString("yyyy-MM-dd")"
                asp-route-to="@Model.To?.ToString("yyyy-MM-dd")"
                class="pagination-button">
                ← Previous
            </a>
        }

        <div class="pagination-pages">

            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <a
                    asp-controller="Home"
                    asp-action="History"
                    asp-route-page="@i"
                    asp-route-keyword="@Model.Keyword"
                    asp-route-from="@Model.From?.ToString("yyyy-MM-dd")"
                    asp-route-to="@Model.To?.ToString("yyyy-MM-dd")"
                    class="pagination-page @(i == Model.CurrentPage ? "active" : "")">
                    @i
                </a>
            }

        </div>

        @if (Model.CurrentPage < Model.TotalPages)
        {
            <a
                asp-controller="Home"
                asp-action="History"
                asp-route-page="@(Model.CurrentPage + 1)"
                asp-route-keyword="@Model.Keyword"
                asp-route-from="@Model.From?.ToString("yyyy-MM-dd")"
                asp-route-to="@Model.To?.ToString("yyyy-MM-dd")"
                class="pagination-button">
                Next →
            </a>
        }

    </div>
    }
    

</div>

<div id="detailsModal" class="details-modal">

    <div class="details-modal-content">

        <button
            type="button"
            class="details-modal-close"
            onclick="closeDetails()">
            ×
        </button>

        <div id="detailsModalBody">
            <p class="details-loading">Loading...</p>
        </div>

    </div>

</div>

<script>
    async function openDetails(id) {

        const modal = document.getElementById("detailsModal");
        const body = document.getElementById("detailsModalBody");

        modal.classList.add("show");

        body.innerHTML = `
            <p class="details-loading">Loading...</p>
        `;

        const response = await fetch(`/Home/Details/${id}`);

        if (!response.ok) {
            body.innerHTML = `
                <p class="details-loading">Could not load fact.</p>
            `;
            return;
        }

        const fact = await response.json();

        body.innerHTML = `
            <div class="details-label">CAT FACT</div>

            <p class="details-fact">
                ${fact.fact}
            </p>

            <div class="details-meta">

                <span class="mono">
                    Length:
                    <strong>${fact.length} chars</strong>
                </span>

                <span class="mono">
                    Fetched at:
                    <strong>${fact.createdAt}</strong>
                </span>

            </div>
        `;
    }

    function closeDetails() {
        document
            .getElementById("detailsModal")
            .classList.remove("show");
    }

    document
        .getElementById("detailsModal")
        .addEventListener("click", function (event) {

            if (event.target === this) {
                closeDetails();
            }

        });
</script>